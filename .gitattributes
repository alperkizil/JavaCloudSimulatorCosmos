# Experiment artifacts are committed verbatim. Marking them binary keeps Git from
# applying any line-ending conversion (Windows checkouts default to core.autocrlf=true),
# which would corrupt the compressed and image payloads.
*.gz  binary
*.zip binary
*.png binary
*.pdf binary

# Result CSVs are written with the platform line separator; normalise them on commit so
# a run uploaded from Windows does not show up as a whole-file diff against a Linux one.
docs/ExperimentResults/**/*.csv text eol=lf
docs/ExperimentResults/**/*.json text eol=lf
docs/ExperimentResults/**/*.txt text eol=lf

# These two folders were committed with CRLF line endings before the rules above
# existed. They are kept exactly as committed, so exempt them from normalisation;
# otherwise every fresh checkout shows their 38 files as modified.
docs/ExperimentResults/MakespanVsEnergy_13_07_2026_14_02_48/** -text
docs/ExperimentResults/WaitingTimeVsEnergy_13_07_2026_14_02_51/** -text
