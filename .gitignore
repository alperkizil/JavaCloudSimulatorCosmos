# Compiled class files
*.class
out/
target/
build/

# IDE files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ...but committed experiment artifacts are not build output. A campaign's
# algorithm log is ~116 MB of plain text, past GitHub's 100 MB per-file limit, so it
# ships compressed; without this exception `git add` skips it silently and the run
# lands without its diagnostics.
!docs/ExperimentResults/**/*.zip
!docs/ExperimentResults/**/*.tar.gz

# The libraries in lib/ are committed on purpose (Maven cannot download them in every
# environment); without this exception a jar added or upgraded there is skipped silently.
!lib/*.jar

# Generated simulation reports
reports/

# Generated newExperiments output
results/
